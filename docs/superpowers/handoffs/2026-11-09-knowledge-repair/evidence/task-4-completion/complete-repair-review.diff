+        h.h.store
+            .transaction(|tx| {
+                tx.execute(
+                    "UPDATE intelligence_meta SET value_json=?2 WHERE key=?1",
+                    rusqlite::params![
+                        operation_key(job.id),
+                        serde_json::to_string(&certificate).unwrap()
+                    ],
+                )?;
+                tx.execute(
+                    "INSERT INTO intelligence_meta(key,value_json) VALUES (?1,?2) \
