+    assert!(!generation_path(&h, &source).exists());
+    h.service.reconcile_owned(Arc::new(())).await.unwrap();
+    assert_eq!(h.embeddings.calls.load(Ordering::SeqCst), calls);
+    h.index.shutdown().await.unwrap();
