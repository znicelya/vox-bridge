+        let job = h
+            .service
+            .reindex_owned(blocker, Arc::new(()))
+            .await
+            .unwrap();
+        h.wait_running(job.id).await;
+        occupied.push(job.id);
+    }
+    let queued = h.service.delete_owned(target, Arc::new(())).await.unwrap();
+    assert_eq!(
+        h.h.store.get_job(queued.id).unwrap().unwrap().status,
+        JobStatus::Queued
