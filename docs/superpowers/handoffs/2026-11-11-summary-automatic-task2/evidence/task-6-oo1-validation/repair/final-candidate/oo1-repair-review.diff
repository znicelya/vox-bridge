+            Err(_) => {
+                self.failed.store(true, Ordering::Release);
+                None
+            }
+        }
+    }
+
+    async fn drain(&self) -> AppResult<()> {
+        for key in 0..self.tasks.len() {
+            self.join(key).await;
+        }
+        if self.failed.load(Ordering::Acquire) {
+            Err(AppError::Internal("runtime actual owner stopped".into()))
+        } else {
+            Ok(())
+        }
+    }
