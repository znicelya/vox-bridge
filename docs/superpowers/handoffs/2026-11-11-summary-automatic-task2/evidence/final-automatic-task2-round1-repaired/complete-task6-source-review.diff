+            // cursor. Counting one separator per row is conservative by one
+            // byte, so every returned continuation stays within the wire cap.
+            let mut out=Vec::new(); let mut cursor=None;
+            let mut bytes=b"{\"rows\":[],\"next_cursor\":\"\"}".len()+20;
