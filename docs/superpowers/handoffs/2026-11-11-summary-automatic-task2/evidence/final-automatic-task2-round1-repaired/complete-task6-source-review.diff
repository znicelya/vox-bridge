+        config: h.saved.clone(),
+        credential: CredentialChange::Keep,
+    })
+    .await
+    .unwrap();
+    assert!(
+        app.create_session(h.launch.clone()).await.is_err(),
+        "unready delivery must fence runtime admission"
+    );
+    app.start_intelligence().await.unwrap();
