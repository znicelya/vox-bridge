+                .leaf
+                .descriptors
+                .lock()
+                .expect("actual audio descriptors")
+                == 0
+            {
+                break;
+            }
+            changed.await;
+        }
+        *self.leaf.phase.lock().expect("actual audio child") = LeafPhase::Joined;
