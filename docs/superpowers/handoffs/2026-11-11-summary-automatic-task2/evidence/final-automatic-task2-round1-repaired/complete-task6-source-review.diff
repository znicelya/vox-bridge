+fn retained_final(app: &AppState, session: Uuid) {
+    app.store
+        .append_final_segment(&StoredTranscriptSegment {
+            id: Uuid::new_v4(),
+            session_id: session,
+            direction: "source_to_target".into(),
+            sequence: 1,
+            occurred_at: 2,
+            language: "zh".into(),
+            text: "retained manual input".into(),
+            is_final: true,
+            details: None,
+            occurred_at_ms: None,
+        })
+        .unwrap();
+}
