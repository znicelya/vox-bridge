+    pub(crate) fn require_epoch(&self, epoch: u64) -> AppResult<()> {
+        let state = self.port.control.state.lock().map_err(|_| storage())?;
+        if state.stage != Stage::Live
+            || state.epoch != Some(epoch)
+            || !state.live.load(Ordering::Acquire)
