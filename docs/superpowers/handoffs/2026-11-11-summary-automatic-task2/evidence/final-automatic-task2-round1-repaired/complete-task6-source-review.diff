+#[tokio::test]
+async fn pulse_cancelled_monitor_keeps_its_original_helper_after_multiple_ticks() {
+    let fixture = Fixture::new();
+    let (backend, _, result) = ports(fixture.clone(), "mic", "VoxBridge_M1").await;
+    let ports = result.unwrap();
