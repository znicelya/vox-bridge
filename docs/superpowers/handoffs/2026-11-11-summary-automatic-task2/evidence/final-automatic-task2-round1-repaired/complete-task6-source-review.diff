+fn append(
+    h: &IntelligenceHarness,
+    session: Uuid,
+    direction: &str,
+    sequence: i64,
+    text: &str,
+) -> Uuid {
+    let id = Uuid::new_v4();
+    h.store
+        .append_final_segment(&StoredTranscriptSegment {
