+        .store
+        .transaction(|tx| {
+            Ok((
+                tx.query_row(
+                    "SELECT summary_session_deleting FROM session_lifecycle WHERE session_id=?1",
+                    [session.to_string()],
+                    |r| r.get::<_, i64>(0),
