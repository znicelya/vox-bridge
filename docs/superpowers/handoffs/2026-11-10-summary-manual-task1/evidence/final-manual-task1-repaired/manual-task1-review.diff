+            .lock()
+            .unwrap()
+            .generation
+            .as_ref()
+            .unwrap()
+            .control
+            .clone();
+        let (job, _, _, frame) = claim(&h.store, &control, &h.jobs.closed, &h.jobs.reap)
+            .unwrap()
