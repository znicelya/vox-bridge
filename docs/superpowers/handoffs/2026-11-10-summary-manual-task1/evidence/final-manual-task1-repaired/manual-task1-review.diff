+    let first = capture(&h, &proof, &owner).await;
+    let late = append(&h, session, "unknown-legacy-direction", -2, "后来😀");
+    let next = capture(&h, &proof, &owner).await;
+    assert_eq!(
+        first.rows.iter().map(|r| r.id).collect::<Vec<_>>(),
