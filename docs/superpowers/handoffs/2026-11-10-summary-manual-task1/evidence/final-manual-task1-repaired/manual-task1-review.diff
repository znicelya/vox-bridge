+}
+
+struct RegistryOwner {
+    _file: Arc<File>,
+    _slot: tokio::sync::OwnedSemaphorePermit,
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn summary_session_guard_sql_timeout_retains_actual_owner_and_fence_until_retry() {
+    let h = SummaryHarness::new().await;
+    let session = h.completed_session(&["retained session input"]).await;
+    let file = File::options()
+        .read(true)
+        .write(true)
+        .create_new(true)
+        .open(h.dir.path().join("session-delete-owner.lock"))
+        .unwrap();
+    fs2::FileExt::try_lock_exclusive(&file).unwrap();
+    let slots = Arc::new(tokio::sync::Semaphore::new(16));
+    let owner: OperationLease = Arc::new(RegistryOwner {
+        _file: Arc::new(file),
+        _slot: slots.clone().try_acquire_owned().unwrap(),
+    });
+    let weak = Arc::downgrade(&owner);
+    let guard = h
+        .service
+        .prepare_session_delete_owned(session, owner)
+        .await
+        .unwrap();
+    let (entered, entry) = tokio::sync::oneshot::channel();
+    let (release, gate) = std::sync::mpsc::channel::<()>();
+    let blocked_store = h.store.clone();
+    let blocker = std::thread::spawn(move || {
+        blocked_store.transaction(|_| {
+            let _ = entered.send(());
+            let _ = gate.recv();
+            Ok(())
+        })
+    });
+    tokio::time::timeout(Duration::from_secs(2), entry)
+        .await
+        .unwrap()
+        .unwrap();
+    let mut deletion = Box::pin(guard.delete_owned(session));
+    let began = std::time::Instant::now();
+    let observed = tokio::time::timeout(Duration::from_secs(11), deletion.as_mut()).await;
+    let still_waiting = observed.is_err();
+    let observed_timeout = matches!(
+        observed,
+        Ok(Err(AppError::Intelligence(IntelligenceErrorCode::Timeout)))
+    );
+    let elapsed = began.elapsed();
+    let retained = weak.upgrade().is_some();
+    let available = slots.available_permits();
+    drop(release);
+    blocker.join().unwrap().unwrap();
+    if still_waiting {
+        let _ = deletion.as_mut().await;
+    }
+    drop(deletion);
+    tokio::time::timeout(Duration::from_secs(2), async {
+        while weak.upgrade().is_some() || slots.available_permits() != 16 {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    let preserved = h.store.get_session(session).unwrap().is_some();
+    let fenced = h
+        .store
+        .transaction(|tx| {
+            Ok(tx.query_row(
+                "SELECT summary_session_deleting FROM session_lifecycle WHERE session_id=?1",
+                [session.to_string()],
+                |r| r.get::<_, i64>(0),
+            )?)
+        })
+        .unwrap();
+    let retry = h
+        .service
+        .prepare_session_delete_owned(session, h.process.clone())
+        .await
+        .unwrap();
+    retry.delete_owned(session).await.unwrap();
+    h.close().await;
+    assert!(
+        observed_timeout,
+        "the final session DELETE observer must return its own 10s Timeout while SQLite remains owned"
+    );
+    assert!(elapsed >= Duration::from_secs(9) && elapsed < Duration::from_secs(11));
+    assert!(retained && preserved);
+    assert_eq!(available, 15);
+    assert_eq!(fenced, 1);
+    assert!(h.store.get_session(session).unwrap().is_none());
+}
+#[tokio::test]
+async fn summary_attempt_registry_bound_and_last_clone_require_actual_slot_release() {
+    let dir = tempfile::tempdir().unwrap();
+    let file = File::options()
+        .read(true)
+        .write(true)
+        .create_new(true)
+        .open(dir.path().join("registry-process.lock"))
+        .unwrap();
+    fs2::FileExt::try_lock_exclusive(&file).unwrap();
+    let file = Arc::new(file);
+    let slots = Arc::new(tokio::sync::Semaphore::new(16));
+    let registry = AttemptRegistry::default();
+    let mut attempts = Vec::new();
+    let mut ids = Vec::new();
+    for _ in 0..16 {
+        let id = Uuid::new_v4();
+        let owner: OperationLease = Arc::new(RegistryOwner {
+            _file: file.clone(),
+            _slot: slots.clone().try_acquire_owned().unwrap(),
+        });
+        attempts.push(registry.register(id, owner).unwrap());
+        ids.push(id);
+    }
+    let overflow: OperationLease = file.clone();
+    assert!(matches!(
+        registry.register(Uuid::new_v4(), overflow),
+        Err(AppError::Intelligence(IntelligenceErrorCode::Busy))
+    ));
+    assert_eq!(slots.available_permits(), 0);
+    let retained = attempts[0].clone();
+    attempts.remove(0);
+    assert!(registry.with_idle(&[ids[0]], || Ok(())).unwrap().is_none());
+    assert_eq!(slots.available_permits(), 0);
+    drop(retained);
+    assert!(registry.with_idle(&[ids[0]], || Ok(())).unwrap().is_some());
+    assert_eq!(slots.available_permits(), 1);
+    drop(attempts);
+    registry.drain().await.unwrap();
+    assert_eq!(slots.available_permits(), 16);
+}
diff --git a/src-tauri/src/summary/tests/harness.rs b/src-tauri/src/summary/tests/harness.rs
new file mode 100644
index 0000000..f573f7e
--- /dev/null
+++ b/src-tauri/src/summary/tests/harness.rs
@@ -0,0 +1,259 @@
+use super::super::{
+    SummaryJobRequest, SummaryService,
+    types::{NativeSummaryView, SummaryView},
+};
+use crate::{
+    app::CredentialChange,
+    config::{ConfigIo, ConfigStore, SecretStore},
+    error::AppResult,
+    intelligence::{
+        config::ServiceConfigStore,
+        jobs::{JobScheduler, OperationLease},
+        types::*,
+    },
+    llm::{LlmExecution, LlmProvider, LlmRequest, LlmResponse},
+    storage::{LocalStore, StoredSession, StoredSessionLifecycle, StoredTranscriptSegment},
+};
+use fs2::FileExt;
+use sha2::{Digest, Sha256};
+use std::{
+    collections::VecDeque,
+    fs::File,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::Duration,
+};
+use tokio::sync::Notify;
+use uuid::Uuid;
+
+pub(super) const VALID: &str = r#"{"summary":"24V需求","participants":[],"companies":[],"requirements":["24V"],"action_items":[],"risks":[],"terms":[]}"#;
+
+#[derive(Default)]
+pub(super) struct RecordingLlm {
+    responses: Mutex<VecDeque<String>>,
+    pub calls: Mutex<Vec<(ModelProfile, LlmRequest)>>,
+    pub block: AtomicBool,
+    pub entered: Notify,
+    pub release: Notify,
+}
+impl RecordingLlm {
+    pub fn push(&self, response: &str) {
+        self.responses.lock().unwrap().push_back(response.into());
+    }
+}
+#[async_trait::async_trait]
+impl LlmProvider for RecordingLlm {
+    async fn complete(
+        &self,
+        profile: &ModelProfile,
+        request: LlmRequest,
+        execution: LlmExecution,
+    ) -> Result<LlmResponse, IntelligenceErrorCode> {
+        // The external completion double retains the complete real job-child scope.
+        let _execution = execution;
+        self.calls.lock().unwrap().push((profile.clone(), request));
+        self.entered.notify_one();
+        if self.block.load(Ordering::SeqCst) {
+            self.release.notified().await;
+        }
+        let content = self
+            .responses
+            .lock()
+            .unwrap()
+            .pop_front()
+            .unwrap_or_else(|| VALID.into());
+        let response_hash = format!("{:x}", Sha256::digest(content.as_bytes()));
+        Ok(LlmResponse {
+            content,
+            response_hash,
+        })
+    }
+}
+
+pub(super) struct SummaryHarness {
+    pub store: Arc<LocalStore>,
+    pub config: Arc<ServiceConfigStore>,
+    pub io: ConfigIo,
+    pub jobs: Arc<JobScheduler>,
+    pub service: SummaryService,
+    pub llm: Arc<RecordingLlm>,
+    pub profile: ModelProfile,
+    pub process: OperationLease,
+    pub dir: tempfile::TempDir,
+}
+impl SummaryHarness {
+    pub async fn new() -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let process = File::options()
+            .read(true)
+            .write(true)
+            .create_new(true)
+            .open(dir.path().join("harness-process.lock"))
+            .unwrap();
+        process.try_lock_exclusive().unwrap();
+        let process: OperationLease = Arc::new(process);
+        let store = Arc::new(LocalStore::open(dir.path()).unwrap());
+        let secrets = Arc::new(SecretStore::for_tests(dir.path()).unwrap());
+        let io = ConfigIo::with_runtime_for_tests(
+            ConfigStore::new(dir.path(), secrets).unwrap(),
+            Arc::new(tokio::sync::Semaphore::new(2)),
+            Duration::from_secs(10),
+        );
+        let config = Arc::new(ServiceConfigStore::new(io.clone(), store.clone()));
+        let profile = crate::intelligence::test_support::test_llm_profile();
+        config
+            .save(SaveModelProfile {
+                profile: profile.clone(),
+                credential: CredentialChange::Replace {
+                    api_key: "synthetic-summary-key".into(),
+                },
+            })
+            .await
+            .unwrap();
+        config
+            .save_settings(IntelligenceSettings {
+                summary_profile_id: Some(profile.id),
+                ..Default::default()
+            })
+            .await
+            .unwrap();
+        let llm = Arc::new(RecordingLlm::default());
+        let jobs = Arc::new(JobScheduler::new(store.clone()));
+        let service = SummaryService::new(store.clone(), config.clone(), jobs.clone(), llm.clone());
+        service.register_handler().unwrap();
+        jobs.reconcile().unwrap();
+        service
+            .reconcile_local_owned(process.clone(), 0, jobs.reap_port())
+            .await
+            .unwrap();
+        jobs.start_owned(process.clone()).unwrap();
+        Self {
+            store,
+            config,
+            io,
+            jobs,
+            service,
+            llm,
+            profile,
+            process,
+            dir,
+        }
+    }
+    pub async fn completed_session(&self, finals: &[&str]) -> Uuid {
+        let id = Uuid::new_v4();
+        self.store
+            .create_session(&StoredSession {
+                id,
+                started_at: 17,
+                mode: "live".into(),
+                direction: "source_to_target".into(),
+                source_language: "en".into(),
+                target_language: "zh".into(),
+            })
+            .unwrap();
+        for (sequence, text) in finals.iter().enumerate() {
+            self.insert_final(id, "source_to_target", sequence as i64, text);
+        }
+        self.store
+            .update_session_lifecycle(&StoredSessionLifecycle {
+                session_id: id,
+                status: "completed".into(),
+                ended_at: Some(23),
+            })
+            .unwrap();
+        id
+    }
+    pub fn insert_final(&self, session: Uuid, direction: &str, sequence: i64, text: &str) -> Uuid {
+        let id = Uuid::new_v4();
+        self.store
+            .append_final_segment(&StoredTranscriptSegment {
+                id,
+                session_id: session,
+                direction: direction.into(),
+                sequence,
+                occurred_at: 19,
+                language: "zh".into(),
+                text: text.into(),
+                is_final: true,
+                details: None,
+                occurred_at_ms: None,
+            })
+            .unwrap();
+        id
+    }
+    pub async fn generate(&self, session: Uuid, profile: Option<Uuid>) -> AppResult<JobView> {
+        self.service
+            .generate_owned(session, profile, self.process.clone())
+            .await
+    }
+    pub async fn run_jobs(&self, id: Uuid) -> JobView {
+        self.jobs.wake();
+        tokio::time::timeout(Duration::from_secs(5), async {
+            loop {
+                let row = self.store.get_job(id).unwrap().unwrap();
+                if !matches!(row.status, JobStatus::Queued | JobStatus::Running) {
+                    return row;
+                }
+                tokio::time::sleep(Duration::from_millis(5)).await;
+            }
+        })
+        .await
+        .expect("actual scheduler must finish the admitted summary")
+    }
+    pub async fn wait(&self, id: Uuid) -> JobView {
+        self.run_jobs(id).await
+    }
+    pub async fn llm_entered(&self) {
+        let entered =
+            tokio::time::timeout(Duration::from_secs(2), self.llm.entered.notified()).await;
+        if entered.is_err() {
+            self.llm.release.notify_one();
+            self.jobs.shutdown().await.unwrap();
+        }
+        assert!(
+            entered.is_ok(),
+            "actual summary handler did not enter the LLM within the fixture deadline"
+        );
+    }
+    pub fn native_versions(&self, session: Uuid) -> AppResult<Vec<NativeSummaryView>> {
+        self.service.list(session, None, 100).map(|page| {
+            page.rows
+                .into_iter()
+                .map(|row| match row {
+                    SummaryView::Native(v) => v,
+                    SummaryView::Legacy(_) => panic!("native fixture was projected as Legacy"),
+                })
+                .collect()
+        })
+    }
+    pub fn raw_responses(&self, id: Uuid) -> AppResult<Vec<String>> {
+        self.store.transaction(|tx| {
+            let mut q=tx.prepare("SELECT raw_text FROM summary_responses WHERE summary_id=?1 ORDER BY ordinal LIMIT 64")?;
+            let rows=q.query_map([id.to_string()],|r|r.get::<_,String>(0))?.collect::<Result<Vec<_>,_>>()?;
+            assert!(rows.iter().all(|r|r.len()<=2*1024*1024));
+            Ok(rows)
+        })
+    }
+    pub fn coverage(&self, id: Uuid) -> AppResult<Vec<(String, u32, u32)>> {
+        self.store.transaction(|tx| {
+            let mut q=tx.prepare("SELECT segment_id,part_index,part_count FROM summary_coverage WHERE summary_id=?1 ORDER BY segment_id,part_index LIMIT 100001")?;
+            Ok(q.query_map([id.to_string()],|r|Ok((r.get(0)?,r.get(1)?,r.get(2)?)))?.collect::<Result<Vec<_>,_>>()?)
+        })
+    }
+    pub async fn delete(&self, id: Uuid) -> AppResult<()> {
+        self.service.delete_owned(id, self.process.clone()).await
+    }
+    pub async fn close(&self) {
+        self.jobs.shutdown().await.unwrap();
+    }
+    pub fn create_stored(&self, session: Uuid, automatic: bool) -> AppResult<JobView> {
+        self.store.create_summary_job(SummaryJobRequest {
+            session_id: session,
+            profile: Some(self.profile.clone()),
+            automatic,
+            initial_failure: None,
+        })
+    }
+}
