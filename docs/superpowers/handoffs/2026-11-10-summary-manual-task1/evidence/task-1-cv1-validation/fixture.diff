+fn preflight(store: &LocalStore, profile: &ModelProfile, reap: &JobReapPort) -> AppResult<Value> {
+    let start = Instant::now();
+    let result = store.transaction(|tx| {
+        let count = |sql: &str| -> rusqlite::Result<i64> {
+            tx.query_row(sql, [], |row| row.get(0))
+        };
+        let summaries = count("SELECT count(*) FROM session_summaries WHERE origin='native'")?;
+        let jobs = count("SELECT count(*) FROM intelligence_jobs")?;
+        let coherent: i64 = tx.query_row(
+            "SELECT count(*) FROM session_summaries s JOIN intelligence_jobs j ON j.id=s.job_id WHERE s.origin='native' AND s.session_id=?1 AND s.profile_id=?2 AND s.model=?3 AND s.status='interrupted' AND s.error_code='interrupted' AND s.structured_json='null' AND s.deleting=0 AND s.input_hash IS NULL AND s.input_final_count IS NULL AND s.snapshot_last_rowid IS NULL AND s.raw_response_hash IS NULL AND s.raw_response_bytes=0 AND s.created_at=s.created_at_ms/1000 AND j.kind='summary' AND j.session_id=s.session_id AND j.object_id=s.id AND j.exclusion_key='summary:'||s.session_id AND j.permanent_key IS NULL AND j.status=s.status AND j.error_code=s.error_code AND j.completed_units=0 AND j.total_units IS NULL AND j.created_at_ms=s.created_at_ms AND j.updated_at_ms=j.created_at_ms+1",
+            params![session_id().to_string(),profile.id.to_string(),profile.model],
+            |row| row.get(0),
+        )?;
+        let (min_version, max_version, distinct_versions): (i64,i64,i64) = tx.query_row(
+            "SELECT min(version),max(version),count(DISTINCT version) FROM session_summaries",
+            [],|row| Ok((row.get(0)?,row.get(1)?,row.get(2)?)),
+        )?;
+        let counter:i64=tx.query_row("SELECT last_version FROM summary_version_counters WHERE session_id=?1",[session_id().to_string()],|row|row.get(0))?;
+        let active = count("SELECT count(*) FROM intelligence_jobs WHERE status IN ('queued','running')")?;
+        let deleting = count("SELECT count(*) FROM session_summaries WHERE deleting<>0")?;
+        let session_deleting=count("SELECT count(*) FROM session_lifecycle WHERE summary_session_deleting<>0")?;
+        let response_rows=count("SELECT count(*) FROM summary_responses")?;
+        let coverage_rows=count("SELECT count(*) FROM summary_coverage")?;
+        let sessions=count("SELECT count(*) FROM sessions")?;
+        let completed_sessions=count("SELECT count(*) FROM session_lifecycle WHERE status='completed'")?;
+        let legacy=count("SELECT count(*) FROM session_summaries WHERE origin<>'native'")?;
+        let mut foreign_keys=tx.prepare("PRAGMA foreign_key_check")?;
+        let mut foreign_rows=foreign_keys.query([])?;
+        assert!(foreign_rows.next()?.is_none(),"fixture has a foreign-key violation");
+        assert_eq!((summaries,jobs,coherent,distinct_versions,counter,max_version),(i64::from(ROWS),i64::from(ROWS),i64::from(ROWS),i64::from(ROWS),i64::from(ROWS),i64::from(ROWS)));
+        assert_eq!(min_version,1);
+        assert_eq!((active,deleting,session_deleting,response_rows,coverage_rows,legacy),(0,0,0,0,0,0));
+        assert_eq!((sessions,completed_sessions),(1,1));
+        let mut samples=Vec::new();
+        for version in [1,ROWS] {
+            let anchored=SummaryJobProof::anchored_in_tx(tx,job_id(version))?.expect("seed sample needs real anchored Native proof");
+            assert_eq!(anchored.summary_id(),summary_id(version));
+            assert_eq!(anchored.session_id(),session_id());
+            assert_eq!(anchored.profile(),Some(profile));
+            let actual=reap.prove(tx,job_id(version))?.expect("seed sample needs actual fresh scheduler/reap proof");
+            samples.push(serde_json::to_value(actual.evidence()).unwrap());
+        }
+        Ok(json!({
+            "native_rows":summaries,"jobs":jobs,"coherent_joined_rows":coherent,
+            "versions":{"min":min_version,"max":max_version,"distinct":distinct_versions,"durable_counter":counter},
+            "active_jobs":active,"deleting_summaries":deleting,"deleting_sessions":session_deleting,
+            "raw_response_rows":response_rows,"coverage_rows":coverage_rows,"legacy_rows":legacy,
+            "sessions":sessions,"completed_sessions":completed_sessions,"foreign_key_violations":0,
+            "actual_reap_samples":samples,
+            "preflight_excluded_from_recovery_interval":true,
+        }))
+    })?;
+    let mut result = result;
+    result["preflight_elapsed_ns"] = json!(ns(start.elapsed()));
+    Ok(result)
+}
