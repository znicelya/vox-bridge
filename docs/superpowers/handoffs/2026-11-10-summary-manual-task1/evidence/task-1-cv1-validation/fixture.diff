+fn seed(store: &LocalStore, profile: &ModelProfile) -> AppResult<Value> {
+    validate_profile(profile)?;
+    let start = Instant::now();
+    let session = session_id();
+    store.create_session(&StoredSession {
+        id: session,
+        started_at: 1_800_000_000,
+        mode: "live".into(),
+        direction: "source_to_target".into(),
+        source_language: "en".into(),
+        target_language: "zh".into(),
+    })?;
+    store.update_session_lifecycle(&StoredSessionLifecycle {
+        session_id: session,
+        status: "completed".into(),
+        ended_at: Some(1_800_000_600),
+    })?;
+    let payload_sequence_sha256 = store.transaction(|tx| {
+        let mut jobs = tx.prepare(
+            "INSERT INTO intelligence_jobs(id,kind,status,session_id,object_id,exclusion_key,permanent_key,payload_json,completed_units,total_units,error_code,created_at_ms,updated_at_ms) VALUES(?1,'summary','interrupted',?2,?3,?4,NULL,?5,0,NULL,'interrupted',?6,?7)",
+        )?;
+        let mut summaries = tx.prepare(
+            "INSERT INTO session_summaries(id,session_id,version,created_at,status,structured_json,profile_id,model,error_code,origin,job_id,created_at_ms,job_payload_hash) VALUES(?1,?2,?3,?4,'interrupted','null',?5,?6,'interrupted','native',?7,?8,?9)",
+        )?;
+        let mut payloads = Sha256::new();
+        let session = session.to_string();
+        let exclusion = format!("summary:{session}");
+        let profile_id = profile.id.to_string();
+        for version in 1..=ROWS {
+            let summary = summary_id(version).to_string();
+            let job = job_id(version).to_string();
+            let raw = serde_json::to_string(&JobPayload {
+                version: 1,
+                profiles: vec![profile.clone()],
+                input: json!({"summary_id":summary,"session_id":session}),
+            })
+            .unwrap();
+            // Hash the exact serialized string bound into the matching job SQL.
+            let witness = format!("{:x}", Sha256::digest(raw.as_bytes()));
+            payloads.update(u64::try_from(raw.len()).unwrap().to_le_bytes());
+            payloads.update(raw.as_bytes());
+            let created_ms = 1_800_000_600_000_i64 + i64::from(version);
+            jobs.execute(params![
+                job,
+                session,
+                summary,
+                exclusion,
+                raw,
+                created_ms,
+                created_ms + 1,
+            ])?;
+            summaries.execute(params![
+                summary,
+                session,
+                version,
+                created_ms / 1000,
+                profile_id,
+                profile.model,
+                job,
+                created_ms,
+                witness,
+            ])?;
+        }
+        drop(jobs);
+        drop(summaries);
+        tx.execute(
+            "INSERT INTO summary_version_counters(session_id,last_version) VALUES(?1,?2) ON CONFLICT(session_id) DO UPDATE SET last_version=excluded.last_version",
+            params![session, ROWS],
+        )?;
+        Ok(format!("{:x}", payloads.finalize()))
+    })?;
+    Ok(json!({
+        "rows":ROWS,
+        "sessions":1,
+        "terminal_state":"Interrupted / Interrupted; no model execution",
+        "session_id":session,
+        "profile":profile,
+        "seeding_elapsed_ns":ns(start.elapsed()),
+        "seeding_excluded_from_recovery_interval":true,
+        "payload_sequence_sha256":payload_sequence_sha256,
+        "payload_sequence_hash_encoding":"version ascending; u64 little-endian raw length followed by exact UTF-8 raw bytes",
+    }))
+}
