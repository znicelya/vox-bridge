+#[derive(Clone, serde::Serialize)]
+struct OwnerRelease {
+    elapsed_ns_from_measurement_start: u64,
+    file_closed: bool,
+    direct_permit_released: bool,
+    direct_slots_before_release: usize,
+    direct_slots_after_release: usize,
+    actual_slots_before_owner_release: usize,
+    actual_slots_after_owner_release: usize,
+}
+struct ObservedLease {
+    file: Option<File>,
+    direct_permit: Option<OwnedSemaphorePermit>,
+    direct: Arc<Semaphore>,
+    actual: Arc<Semaphore>,
+    timer: Arc<Mutex<Option<Instant>>>,
+    release: Arc<Mutex<Option<OwnerRelease>>>,
+}
+impl Drop for ObservedLease {
+    fn drop(&mut self) {
+        let direct_before = self.direct.available_permits();
+        let actual_before = self.actual.available_permits();
+        let file = self.file.take();
+        let file_closed = file.is_some();
+        drop(file);
+        let permit = self.direct_permit.take();
+        let direct_permit_released = permit.is_some();
+        drop(permit);
+        let released = OwnerRelease {
+            elapsed_ns_from_measurement_start: self
+                .timer
+                .lock()
+                .unwrap()
+                .as_ref()
+                .map(|start| ns(start.elapsed()))
+                .unwrap_or(0),
+            file_closed,
+            direct_permit_released,
+            direct_slots_before_release: direct_before,
+            direct_slots_after_release: self.direct.available_permits(),
+            actual_slots_before_owner_release: actual_before,
+            actual_slots_after_owner_release: self.actual.available_permits(),
+        };
+        *self.release.lock().unwrap() = Some(released);
+    }
+}
