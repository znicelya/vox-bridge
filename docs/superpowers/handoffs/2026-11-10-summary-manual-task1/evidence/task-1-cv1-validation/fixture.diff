+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn cv1_recovery_near_200000_native_history_one_measurement() {
+    let data = PathBuf::from(std::env::var_os("VOXBRIDGE_CV1_DATA_DIR").unwrap());
+    let artifacts = PathBuf::from(std::env::var_os("VOXBRIDGE_CV1_ARTIFACT_DIR").unwrap());
+    std::fs::create_dir(&data).expect("fixture must use a new preserved data directory");
+    let store = Arc::new(LocalStore::open(&data).unwrap());
+    let secrets = Arc::new(SecretStore::for_tests(&data).unwrap());
+    let config_slots = Arc::new(Semaphore::new(2));
+    let io = ConfigIo::with_runtime_for_tests(
+        ConfigStore::new(&data, secrets).unwrap(),
+        config_slots.clone(),
+        Duration::from_secs(10),
+    );
+    let config = Arc::new(ServiceConfigStore::new(io.clone(), store.clone()));
+    let mut profile = crate::intelligence::test_support::test_llm_profile();
+    profile.id = Uuid::from_u128(0x40000000000000000000000000000001);
+    let seeded = seed(&store, &profile).unwrap();
+    write_json(&artifacts, "seed.json", &seeded);
+    println!("CV1_SEED {}", seeded);
+    let llm = Arc::new(CountingLlm::default());
+    let jobs = Arc::new(JobScheduler::new(store.clone()));
+    let service = SummaryService::new(store.clone(), config.clone(), jobs.clone(), llm.clone());
+    service.register_handler().unwrap();
+    jobs.reconcile().unwrap();
+    // The real new registry is Fresh; no worker generation or active claim exists.
+    let reap = jobs.reap_port();
+    let preflight = preflight(&store, &profile, &reap).unwrap();
+    write_json(&artifacts, "preflight.json", &preflight);
+    println!("CV1_PREFLIGHT {}", preflight);
+    assert!(service.require_epoch(EPOCH).is_err());
+    assert_eq!(llm.calls.load(Ordering::SeqCst), 0);
+    let actual = service.core.recovery.actual.clone();
+    let direct = Arc::new(Semaphore::new(16));
+    let timer = Arc::new(Mutex::new(None));
+    let release = Arc::new(Mutex::new(None));
+    let lock_path = data.join("cv1-process.lock");
+    let file = File::options()
+        .read(true)
+        .write(true)
+        .create_new(true)
+        .open(&lock_path)
+        .unwrap();
+    FileExt::try_lock_exclusive(&file).unwrap();
+    let lock_probe = File::options()
+        .read(true)
+        .write(true)
+        .open(&lock_path)
+        .unwrap();
+    assert!(FileExt::try_lock_exclusive(&lock_probe).is_err());
+    let owner: OperationLease = Arc::new(ObservedLease {
+        file: Some(file),
+        direct_permit: Some(direct.clone().try_acquire_owned().unwrap()),
+        direct: direct.clone(),
+        actual: actual.clone(),
+        timer: timer.clone(),
+        release: release.clone(),
+    });
+    let weak = Arc::downgrade(&owner);
+    assert_eq!(
+        (direct.available_permits(), actual.available_permits()),
+        (15, 1)
+    );
+    println!(
+        "CV1_MEASUREMENT_BEGIN rows={} production_deadline_seconds=10 outer_seconds=15",
+        ROWS
+    );
+    let start = Instant::now();
+    *timer.lock().unwrap() = Some(start);
+    let returned = tokio::time::timeout(
+        Duration::from_secs(15),
+        service.reconcile_local_owned(owner, EPOCH, reap),
+    )
+    .await;
+    let ready_at_return = service.require_epoch(EPOCH);
+    let elapsed_ns = ns(start.elapsed());
+    let returned_code = match &returned {
+        Ok(Ok(_)) => "Ready".into(),
+        Ok(result) => safe_code(result),
+        Err(_) => "OuterTimeout".into(),
+    };
+    let owner_live_at_return = weak.strong_count() > 0;
+    let direct_at_return = direct.available_permits();
+    let actual_at_return = actual.available_permits();
+    let release_at_return = release.lock().unwrap().clone();
+    let lock_free_at_return = FileExt::try_lock_exclusive(&lock_probe).is_ok();
+    if lock_free_at_return {
+        FileExt::unlock(&lock_probe).unwrap();
+    }
+    println!(
+        "CV1_MEASUREMENT_RETURN code={} elapsed_ns={} ready={} provider_calls={} owner_live={} actual_slots={} direct_slots={}",
+        returned_code,
+        elapsed_ns,
+        ready_at_return.is_ok(),
+        llm.calls.load(Ordering::SeqCst),
+        owner_live_at_return,
+        actual_at_return,
+        direct_at_return
+    );
+    // This is actual completion collection, outside the single timed interval.
+    let cleanup_start = Instant::now();
+    let bounded_drain = tokio::time::timeout(Duration::from_secs(15), service.drain_actual()).await;
+    let drain_within_bound = matches!(&bounded_drain, Ok(Ok(())));
+    let drain_code = match &bounded_drain {
+        Ok(result) => safe_code(result),
+        Err(_) => "OuterTimeout".into(),
+    };
+    if !drain_within_bound {
+        service.drain_actual().await.unwrap();
+    }
+    let shutdown = jobs.shutdown().await;
+    let ready_after_drain = service.require_epoch(EPOCH);
+    drop(returned);
+    drop(service);
+    drop(jobs);
+    drop(config);
+    drop(io);
+    drop(store);
+    let owner_release = release.lock().unwrap().clone();
+    let owner_gone = weak.strong_count() == 0;
+    let direct_after = direct.available_permits();
+    let actual_after = actual.available_permits();
+    let config_after = config_slots.available_permits();
+    let lock_reacquired = FileExt::try_lock_exclusive(&lock_probe).is_ok();
+    if lock_reacquired {
+        FileExt::unlock(&lock_probe).unwrap();
+    }
+    drop(lock_probe);
+    let provider_calls = llm.calls.load(Ordering::SeqCst);
+    let release_order = owner_release.as_ref().is_some_and(|event| {
+        event.file_closed
+            && event.direct_permit_released
+            && event.direct_slots_before_release == 15
+            && event.direct_slots_after_release == 16
+            && event.actual_slots_before_owner_release == 0
+            && event.actual_slots_after_owner_release == 0
+    });
+    let outcome_consistent = match returned_code.as_str() {
+        "Ready" => {
+            ready_at_return.is_ok() && ready_after_drain.is_ok() && elapsed_ns < 10_000_000_000
+        }
+        "Timeout" => ready_at_return.is_err() && ready_after_drain.is_err(),
+        _ => false,
+    };
+    let measurement = json!({
+        "fixture":"summary::recovery::cv1_validation::cv1_recovery_near_200000_native_history_one_measurement",
+        "completed_timed_measurements":1,"rows":ROWS,"epoch":EPOCH,
+        "production_deadline_ns":10_000_000_000_u64,"outer_observation_ns":15_000_000_000_u64,
+        "timed_scope":"one actual reconcile_local_owned call through require_epoch readiness observation",
+        "returned_code":returned_code,"elapsed_ns":elapsed_ns,
+        "ready_at_return":ready_at_return.is_ok(),"readiness_code_at_return":safe_code(&ready_at_return),
+        "ready_after_actual_drain":ready_after_drain.is_ok(),"readiness_code_after_actual_drain":safe_code(&ready_after_drain),
+        "provider_calls":provider_calls,
+        "return_observations":{"owner_live":owner_live_at_return,"direct_slots":direct_at_return,"actual_slots":actual_at_return,"release":release_at_return,"process_lock_free":lock_free_at_return},
+        "owner_release":owner_release,
+        "cleanup":{"bounded_actual_drain_code":drain_code,"actual_drain_within_15s":drain_within_bound,"actual_drain_joined":true,"scheduler_shutdown_ok":shutdown.is_ok(),"scheduler_shutdown_code":safe_code(&shutdown),"owner_gone":owner_gone,"direct_slots":direct_after,"actual_slots":actual_after,"config_slots":config_after,"process_lock_reacquired":lock_reacquired,"elapsed_ns":ns(cleanup_start.elapsed())},
+        "checks":{"outcome_and_readiness_consistent":outcome_consistent,"actual_owner_release_order":release_order,"zero_provider_calls":provider_calls==0},
+        "availability_established":returned_code=="Ready" && outcome_consistent,
+        "seed":seeded,"preflight":preflight,
+    });
+    write_json(&artifacts, "measurement.json", &measurement);
+    println!("CV1_MEASUREMENT_JSON {}", measurement);
+    assert!(
+        outcome_consistent,
+        "actual measurement returned an unexpected code/readiness/latency result; see preserved JSON"
+    );
+    assert!(
+        drain_within_bound && shutdown.is_ok(),
+        "actual cleanup exceeded its bound or shutdown failed"
+    );
+    assert!(
+        owner_gone && lock_reacquired && release_order,
+        "actual owner/lock release failed"
+    );
+    assert_eq!((direct_after, actual_after, config_after), (16, 1, 2));
+    assert_eq!(provider_calls, 0);
+}
