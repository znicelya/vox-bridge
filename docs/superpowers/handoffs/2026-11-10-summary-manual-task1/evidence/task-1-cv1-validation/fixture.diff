+fn session_id() -> Uuid {
+    Uuid::from_u128(0x10000000000000000000000000000001)
+}
+fn summary_id(version: u32) -> Uuid {
+    Uuid::from_u128(0x20000000000000000000000000000000 | u128::from(version))
+}
+fn job_id(version: u32) -> Uuid {
+    Uuid::from_u128(0x30000000000000000000000000000000 | u128::from(version))
+}
+fn ns(duration: Duration) -> u64 {
+    u64::try_from(duration.as_nanos()).unwrap()
+}
+fn safe_code<T>(result: &AppResult<T>) -> String {
+    match result {
+        Ok(_) => "Ok".into(),
+        Err(AppError::Intelligence(code)) => format!("{code:?}"),
+        Err(_) => "OtherAppError".into(),
+    }
+}
+fn write_json(dir: &Path, name: &str, value: &Value) {
+    let mut bytes = serde_json::to_vec_pretty(value).unwrap();
+    bytes.push(b'\n');
+    std::fs::write(dir.join(name), bytes).unwrap();
+}
